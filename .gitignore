.DS_Store
__pycache__/
*.pyc
*.db-journal
*.sqlite-journal
/tmp/
*.log
/database.sqlite
# Astro frontend build sync backups (local rollback only — never committed)
webapp/static.bak/
webapp/static.broken/
# Display-fidelity validation artifacts (PDF comparison PNGs + fidelity.html); dev-only, not shipped
webapp/static/_cmp/

# Node deps — platform-specific binaries must NOT be committed (a Linux-built
# node_modules breaks `npm run build` on macOS). Reproduce with `npm ci`.
frontend/node_modules/
node_modules/
.astro/

# Astro build output (generated; synced into webapp/static/ separately) + Python venvs
frontend/dist/
.venv/
venv/

# Backups & SQLite WAL sidecars
*.bak
*.sqlite-wal
*.sqlite-shm

# Local screenshot review sets
baseline_shots/
new_shots/

# Vercel CLI link state (never commit)
.vercel/

# Third-party brand reference material (not ours to publish)
Brand-files/

# Machine-local agent notes (account identifiers, local gotchas) — never committed
*.local.md

# English translation sources are private (Algorythmos-AI/sggs-source) and never belong here
/pipeline/

# Verified dataset objects fetched from sggs-data (scripts/data/fetch_dataset.py)
.dataset-cache/

# Scripture database installed from sggs-data by pin (make dataset)
/db/
# Search-harness output (tools/*_harness.py)
qa/results/
# Service database slices (make slices)
build/
