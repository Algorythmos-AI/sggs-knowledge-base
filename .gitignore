.DS_Store
__pycache__/
*.pyc
*.db-journal
*.sqlite-journal
/tmp/
*.log
/database.sqlite
# Astro frontend build sync backups (local rollback only — never committed)
webapp/static.bak/
webapp/static.broken/
# Display-fidelity validation artifacts (PDF comparison PNGs + fidelity.html); dev-only, not shipped
webapp/static/_cmp/

# Node deps — platform-specific binaries must NOT be committed (a Linux-built
# node_modules breaks `npm run build` on macOS). Reproduce with `npm ci`.
frontend/node_modules/
node_modules/
.astro/

# Astro build output (generated; synced into webapp/static/ separately) + Python venvs
frontend/dist/
.venv/
venv/

# Backups & SQLite WAL sidecars
*.bak
*.sqlite-wal
*.sqlite-shm

# iOS app: Swift build output + the large derived DB (reproducible via pipeline/build_ios_db.py)
ios/**/.build/
ios/Resources/*.sqlite
ios/**/*.xcodeproj/xcuserdata/
ios/**/DerivedData/

validation/*_results.jsonl

# Xcode app: regenerable project + build output
ios/App/build/
ios/App/*.xcodeproj/
ios/App/*.xcworkspace/
db/backups/

# public-profile iOS DB manifest (built on demand for the degradation-parity gate; the
# .sqlite itself is already covered by ios/Resources/*.sqlite — DB artifacts are never
# committed, CI rebuilds them deterministically)
ios/Resources/sggs-ios-public.manifest.json
