---
import Base from '../layouts/Base.astro';
---
<Base title="ੴ Page not found — Sri Guru Granth Sahib Knowledge Base">
  <section id="v-404" style="text-align:center;padding:48px 16px;max-width:560px;margin:0 auto">
    <div class="gm" lang="pa" style="font-size:44px;color:var(--gold);line-height:1">ੴ</div>
    <h2 style="margin:18px 0 8px">This page isn’t here</h2>
    <p class="soft" style="margin:0 0 22px">The link may be mistyped or out of date. The whole Granth is still a click away.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center">
      <a class="now-btn" href="/">Search</a>
      <a class="now-btn" href="/reader?ang=1">Open Ang 1</a>
      <a class="now-btn" href="/browse">Browse the index</a>
    </div>
  </section>
</Base>
