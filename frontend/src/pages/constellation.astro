---
import Base from '../layouts/Base.astro';
---
<Base title="ੴ Sri Guru Granth Sahib Ji — Concept Constellation">
  <section id="v-constel">
    <div class="hint">Pick a theme and every verse that carries it becomes a <i>star</i>. The stars gather into clusters by the <i>other</i> theme each verse shares most — so you can see which "Naam" verses also lean toward grace, or fear, or surrender. <b>Tap any star</b> (or its Ang) to open the verse in the Reader.<span style="display:block;margin-top:6px;font-size:.88em;opacity:.6">Built from the corpus's verified theme tags — a way to explore, never a ranking of scripture.</span></div>

    <div class="viz-card">
      <div class="viz-head">
        <div>
          <div class="viz-title">Concept Constellation</div>
          <div class="viz-sub" id="conHead">Loading…</div>
        </div>
        <div class="viz-ctl">
          <select id="conSel" class="viz-sel" aria-label="Concept"></select>
          <select id="conAuthor" class="viz-sel" aria-label="Filter by author"></select>
          <select id="conRaag" class="viz-sel" aria-label="Filter by raag"></select>
        </div>
      </div>
      <div id="constel" class="viz-stage constel-stage"></div>
    </div>
  </section>
  <script>import '../scripts/constellation';</script>
</Base>
