---
import Base from '../layouts/Base.astro';
---
<Base title="ੴ Sri Guru Granth Sahib — Contributors">
  <section id="v-lineage">
    <div class="trail-top">
      <div>
        <div class="trail-title">The Contributors</div>
        <div class="trail-sub">Five centuries of voices gathered into one Granth — the Gurus, the Bhagats of the Bhakti and Sufi traditions, the court Bhatts, and the Gursikh companions. <b>Tap any voice</b> to read about them and open their Bani.<span style="display:block;margin-top:6px;font-size:.88em;opacity:.6">Dates are historical approximations; a voice's size reflects how much of its Bani is preserved here — never its importance.</span></div>
      </div>
    </div>
    <div id="tlFilter" class="modes" role="group" aria-label="Filter contributors">
      <span data-k="all" class="on">All</span>
      <span data-k="guru">Gurus</span>
      <span data-k="bhagat">Bhagats</span>
      <span data-k="bhatt">Bhatts</span>
      <span data-k="gursikh">Gursikhs</span>
    </div>
    <div id="timeline" class="timeline"></div>
  </section>
  <script>import '../scripts/lineage';</script>
</Base>
