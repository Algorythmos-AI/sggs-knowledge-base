---
import Base from '../layouts/Base.astro';
---
<Base title="ੴ Sri Guru Granth Sahib — Contributors">
  <section id="v-lineage">
    <div class="trail-top">
      <div>
        <div class="trail-title">The Contributors</div>
        <div class="trail-sub">Five centuries of voices gathered into one Granth — the Gurus, the Bhagats of the Bhakti and Sufi traditions, the court Bhatts, and the Gursikh companions. Tap any voice to read about them and open their Bani. Dates are historical approximations; sizing reflects extent of preserved Bani only, never importance.</div>
      </div>
    </div>
    <div id="tlFilter" class="modes" role="group" aria-label="Filter contributors">
      <span data-k="all" class="on">All</span>
      <span data-k="guru">Gurus</span>
      <span data-k="bhagat">Bhagats</span>
      <span data-k="bhatt">Bhatts</span>
      <span data-k="gursikh">Gursikhs</span>
    </div>
    <div id="timeline" class="timeline"></div>
  </section>
  <script>import '../scripts/lineage';</script>
</Base>
