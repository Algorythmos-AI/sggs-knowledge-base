---
import { getCollection } from "astro:content";
import Marketing from "../../layouts/Marketing.astro";
import MarketingNav from "../../components/MarketingNav.astro";
import MarketingFooter from "../../components/MarketingFooter.astro";
import JsonLd from "../../components/JsonLd.astro";
import { SITE_URL } from "../../site";
import { LEARN_SLUGS } from "../../routes";

const desc =
  "Plain, sourced explanations of Sri Guru Granth Sahib Ji from Gurbani Soul — what a Hukamnama is, how to read Nitnem, the raags and the watches of the day, and how the text is verified.";

const order = new Map(LEARN_SLUGS.map((s, i) => [s, i]));
const articles = (await getCollection("learn"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => {
    const t = b.data.pubDate.getTime() - a.data.pubDate.getTime();
    return t !== 0 ? t : (order.get(a.id) ?? 0) - (order.get(b.id) ?? 0);
  });

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", name: "Gurbani Soul", url: SITE_URL, inLanguage: "en" },
    {
      "@type": "CollectionPage",
      name: "Learn — Sri Guru Granth Sahib Ji",
      description: desc,
      url: new URL("/learn", SITE_URL).href,
      inLanguage: "en",
      isPartOf: { "@type": "WebSite", name: "Gurbani Soul", url: SITE_URL },
    },
  ],
};
---
<Marketing title="Learn — Gurbani Soul" description={desc} path="/learn">
  <JsonLd slot="head" data={jsonLd} />
  <MarketingNav overHero={false} />

  <header class="learn-hero">
    <div class="wrap">
      <p class="eyebrow">Learn</p>
      <h1>Learn about Sri Guru Granth Sahib Ji</h1>
      <p class="lede">Short, plain explanations of how the Granth is read and how Gurbani Soul stays
        faithful to it. Every quotation is verbatim and cited by its Ang; anything that is
        interpretation is clearly labelled as such.</p>
    </div>
  </header>

  <section class="section learn-list-sec">
    <div class="wrap">
      <ul class="learn-list">
        {articles.map((a) => (
          <li class="learn-card">
            <a href={`/learn/${a.id}`}>
              <h2>{a.data.title}</h2>
              <p class="card-desc">{a.data.description}</p>
              <p class="card-meta">
                <time datetime={a.data.pubDate.toISOString().slice(0, 10)}>{fmtDate(a.data.pubDate)}</time>
                <span class="tags">{a.data.tags.map((t) => <span class="tag">{t}</span>)}</span>
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <MarketingFooter />

  <style>
    .learn-hero { padding: clamp(96px, 12vw, 150px) 0 clamp(24px, 4vw, 44px); }
    .learn-hero h1 { font-size: clamp(32px, 5.4vw, 54px); margin: 0 0 18px; }
    .learn-hero .lede { max-width: 56ch; color: var(--ink-soft); font-size: clamp(17px, 2vw, 20px); }
    .learn-list-sec { padding-top: 0; }
    .learn-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
    .learn-card { border-top: 1px solid var(--line); }
    .learn-card:last-child { border-bottom: 1px solid var(--line); }
    .learn-card a { display: block; padding: 26px 0; text-decoration: none; color: inherit; }
    .learn-card h2 { font-size: clamp(20px, 2.6vw, 26px); margin: 0 0 8px; color: var(--ink); }
    .learn-card .card-desc { margin: 0 0 12px; color: var(--ink-soft); font-size: 15.5px; max-width: 66ch; }
    .learn-card .card-meta { margin: 0; display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; font-size: 13px; color: var(--ink-soft); }
    .learn-card .tags { display: inline-flex; flex-wrap: wrap; gap: 8px; }
    .learn-card .tag { border: 1px solid var(--line); border-radius: 999px; padding: 3px 11px; font-size: 12px; color: var(--accent-text); }
    @media (prefers-reduced-motion: no-preference) {
      .learn-card a { transition: opacity .12s ease; }
    }
    .learn-card a:hover h2 { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  </style>
</Marketing>
