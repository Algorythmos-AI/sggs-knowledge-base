---
import Base from '../layouts/Base.astro';
---
<Base title="ੴ Sri Guru Granth Sahib Ji — Raag timing divergence (sources side-by-side)">
  <section id="v-divergence">
    <div class="clock-head">
      <h2>Where the traditions disagree</h2>
      <p class="clock-sub">
        Every raag whose timing carries two or more conflicting claims, side-by-side with
        citations and tradition labels. <b>Disagreement here is preserved scholarship, not
        error</b> — Gurmat Sangeet lineages and Hindustani samay convention genuinely differ,
        and this knowledge base records the difference instead of silently picking a winner.
        <a href="/raag-clock">Back to the Raag Clock →</a>
      </p>
    </div>
    <div class="card" id="divOut"><div class="hint">Loading divergent claims…</div></div>
  </section>
  <script>import '../scripts/divergence';</script>
</Base>
