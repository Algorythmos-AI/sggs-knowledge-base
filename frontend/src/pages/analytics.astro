---
import Base from '../layouts/Base.astro';
---
<Base title="ੴ Sri Guru Granth Sahib — Insights">
  <section id="v-analytics">
    <div class="hint">Offline analytics over the corpus — theme co-occurrence and authorial style. All measures are <i>descriptive</i> (computed once, on the English translation and corpus-verified themes) and are never a ranking or judgement of scripture.</div>

    <div class="viz-card">
      <div class="viz-head">
        <div>
          <div class="viz-title">Theme Co-occurrence Network</div>
          <div class="viz-sub">Nodes sized by frequency · edges weighted &amp; coloured by PPMI (base-rate-corrected association). Drag nodes, scroll to zoom, click a theme to search it.</div>
        </div>
        <label class="viz-ctl">min&nbsp;PPMI <input id="ppmiRange" type="range" min="0" max="3" step="0.1" value="0" /> <span id="ppmiVal" class="viz-val">0.0</span></label>
      </div>
      <div id="network" class="viz-stage"></div>
    </div>

    <div class="viz-card">
      <div class="viz-head">
        <div>
          <div class="viz-title">Author Theme Fingerprint</div>
          <div class="viz-sub">Stylometric radar — each author's distinctive theme emphasis as <b>lift</b> over the corpus baseline (1.0× = average). Pick a second author to overlay a comparison.</div>
        </div>
        <div class="viz-ctl">
          <select id="authA" class="viz-sel" aria-label="Author"></select>
          <select id="authB" class="viz-sel" aria-label="Compare author"></select>
        </div>
      </div>
      <div class="radar-wrap"><canvas id="radar"></canvas></div>
      <div id="radarNote" class="viz-foot"></div>
    </div>
  </section>
  <script>import '../scripts/analytics';</script>
</Base>
