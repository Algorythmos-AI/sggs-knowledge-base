---
// Base.astro — the shared MPA shell: head, header (with theme toggle), nav, footer,
// the shared composition modal (#panel) + toast, and the global core/panel scripts.
import '../styles/global.css';
export interface Props { title?: string; }
const { title = 'ੴ Sri Guru Granth Sahib — Knowledge Base' } = Astro.props;
---
<!DOCTYPE html>
<html lang="pa">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <!-- Resolve the theme before first paint (no flash). Inline + un-bundled on purpose. -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme') || 'system';
        var d = t === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : t;
        document.documentElement.setAttribute('data-theme', d);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header lang="en">
    <div class="onkar gm" aria-hidden="true">ੴ</div>
    <h1>Sri Guru Granth Sahib — Knowledge Base</h1>
    <p>1430 Angs · verbatim Gurmukhi · searchable by word, sound, first letters &amp; theme</p>
    <button id="themeBtn" class="themebtn" type="button" aria-label="Theme" title="Theme">◐</button>
  </header>
  <nav>
    <a href="/" data-path="/">Search</a>
    <a href="/reader" data-path="/reader">Reader</a>
    <a href="/browse" data-path="/browse">Index</a>
    <a href="/themes" data-path="/themes">Themes</a>
    <button id="randomBtn" type="button">Hukam-style random</button>
  </nav>
  <main id="main">
    <slot />
  </main>

  <div id="toast" role="status"></div>
  <div class="panel" id="panel" role="dialog" aria-modal="true" aria-labelledby="ptitle">
    <div class="inner">
      <button class="x" onclick="closePanel()" aria-label="Close">×</button>
      <h3 id="ptitle"></h3>
      <div id="pbody"></div>
    </div>
  </div>
  <footer>Scripture is shown verbatim from your edition with its Ang. Transliteration is a mechanical reading aid, not the scripture. · <span class="gm">ਧੁਰ ਕੀ ਬਾਣੀ</span><span id="ver"></span></footer>

  <script>
    import '../scripts/core';
    import '../scripts/panel';
  </script>
</body>
</html>
