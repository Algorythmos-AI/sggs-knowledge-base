---
// Marketing.astro — the Gurbani Soul marketing shell for `/` (renamed from Landing.astro in the
// PR1 web-foundations pass). Separate from Base.astro (the Knowledge Base's own layout/name/theme,
// per CLAUDE.md). Head SEO/social/PWA is delegated to <Seo>; brand styles live in
// ../styles/marketing.css; Vercel analytics is loaded only on gurbanisoul.com via <Analytics>.
// Visual output is unchanged from Landing.astro — the redesign is PR2.
import { ClientRouter } from "astro:transitions";
import Seo from "../components/Seo.astro";
import Analytics from "../components/Analytics.astro";
import "../styles/marketing.css";
export interface Props {
  title: string;
  description: string;
  path?: string;      // e.g. "/" — for canonical + og:url
  ogImage?: string;   // absolute or root-relative; defaults to the path's OG card
}
const { title, description, path = "/", ogImage } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <Seo title={title} description={description} path={path} ogImage={ogImage} themeColor="light" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- Resolve theme before first paint. The marketing site is LIGHT-FIRST: with no stored choice
       it renders light whatever the OS appearance (the Knowledge Base's Base.astro keeps 'system').
       An explicit choice (localStorage 'theme', shared with the KB) always wins. The single
       theme-color meta follows the resolved page theme (scripts/theme.ts keeps it in step). -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme') || 'light';
        var d = t === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : t;
        document.documentElement.setAttribute('data-theme', d);
        var m = document.getElementById('themeColorMeta');
        if (m) m.setAttribute('content', d === 'dark' ? '#171412' : '#FBF7F0');
      } catch (e) {}
    })();
  </script>
  <link rel="preload" href="/fonts/SantLipi-VF.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/SourceSerif4-latin.woff2" as="font" type="font/woff2" crossorigin />
  <ClientRouter />
  <slot name="head" />
</head>
<body>
  <a href="#main" class="lp-skip">Skip to content</a>
  <main id="main"><slot /></main>
  <Analytics />
  <script>
    // Registers the landing's astro:page-load / before-swap / after-swap listeners exactly once.
    import "../scripts/landing.ts";
  </script>
</body>
</html>
