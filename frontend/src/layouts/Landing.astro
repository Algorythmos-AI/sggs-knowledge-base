---
// Landing.astro — the Gurbani Soul marketing shell for `/`. Separate from Base.astro (the
// Knowledge Base's own layout/name/theme, per CLAUDE.md). Brand tokens follow
// docs/brand/gurbani-soul-brand-book.md + tokens.json: gold on warm paper/ink, gold #FFBC0D only
// as a bordered fill in light mode, gold text only via accentText, never red, Gurmukhi in ink.
import { SITE_URL } from '../site.ts';
export interface Props {
  title: string;
  description: string;
  path?: string;      // e.g. "/" — for canonical + og:url
  ogImage?: string;   // absolute or root-relative
}
const {
  title,
  description,
  path = '/',
  ogImage = '/og.jpg',
} = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const ogAbsolute = new URL(ogImage, SITE_URL).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#FBF7F0" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#171412" media="(prefers-color-scheme: dark)" />
  <meta name="apple-mobile-web-app-title" content="Gurbani Soul" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Gurbani Soul" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogAbsolute} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogAbsolute} />
  <!-- Resolve theme before first paint (shared convention with the Knowledge Base). -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme') || 'system';
        var d = t === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : t;
        document.documentElement.setAttribute('data-theme', d);
      } catch (e) {}
    })();
  </script>
  <link rel="preload" href="/fonts/SantLipi-VF.woff2" as="font" type="font/woff2" crossorigin />
  <style is:global>
    /* Sant Lipi for the ੴ mark and any verbatim Gurmukhi (display only). */
    @font-face {
      font-family: "Sant Lipi";
      src: url("/fonts/SantLipi-VF.woff2") format("woff2");
      font-weight: 100 900; font-display: swap;
      unicode-range: U+0A00-0A7F, U+25CC, U+0964-0965;
    }
    :root {
      /* Soul Gold + warm surfaces (light legs from tokens.json). */
      --paper: #FBF7F0; --paper-2: #FDF6E3; --card: #FFFFFF;
      --ink: #201A12; --ink-soft: #6B5E4B; --line: rgba(43,26,5,.12);
      --accent-fill: #FFBC0D;      /* bordered fill only in light */
      --accent: #A87900;           /* borders/icons */
      --accent-text: #8A6100;      /* gold words */
      --on-accent: #2B1A05;
      --serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
      --sans: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --gm: "Sant Lipi", "Noto Sans Gurmukhi", "Gurmukhi MN", sans-serif;
      --maxw: 1080px;
    }
    :root[data-theme="dark"] {
      --paper: #171412; --paper-2: #0E0C0A; --card: #1E1A17;
      --ink: #F3ECDD; --ink-soft: #B9AC95; --line: rgba(255,255,255,.10);
      --accent-fill: #FFBC0D; --accent: #FFBC0D; --accent-text: #FFC72C; --on-accent: #2B1A05;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --paper: #171412; --paper-2: #0E0C0A; --card: #1E1A17;
        --ink: #F3ECDD; --ink-soft: #B9AC95; --line: rgba(255,255,255,.10);
        --accent-fill: #FFBC0D; --accent: #FFBC0D; --accent-text: #FFC72C; --on-accent: #2B1A05;
      }
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0; background: var(--paper); color: var(--ink);
      font-family: var(--sans); line-height: 1.65; letter-spacing: -.011em;
      -webkit-font-smoothing: antialiased;
    }
    .lp-skip {
      position: absolute; left: -9999px; top: 0; background: var(--card); color: var(--ink);
      padding: 10px 16px; border-radius: 8px; z-index: 100;
    }
    .lp-skip:focus { left: 16px; top: 16px; }
    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 20px; }
    .gm { font-family: var(--gm); }
    h1, h2, h3 { font-family: var(--serif); font-weight: 600; letter-spacing: -.02em; line-height: 1.15; }
    a { color: var(--accent-text); }
    :root[data-theme="dark"] a { color: var(--accent-text); }
    /* Buttons: gold fill always carries a border in light (brand rule §3.1). */
    .btn {
      display: inline-flex; align-items: center; gap: 8px; font-weight: 650; font-family: var(--sans);
      padding: 13px 22px; border-radius: 999px; text-decoration: none; font-size: 16px;
      background: var(--accent-fill); color: var(--on-accent); border: 1px solid var(--accent);
    }
    .btn.ghost { background: transparent; color: var(--accent-text); border-color: var(--line); }
    .btn:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    @media (prefers-reduced-motion: no-preference) {
      .btn { transition: transform .12s ease; }
      .btn:hover { transform: translateY(-1px); }
    }
    .foot { border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 13.5px; }
    .foot a { color: var(--accent-text); }
    .credits { color: var(--ink-soft); font-size: 12.5px; }
  </style>
  <slot name="head" />
</head>
<body>
  <a href="#main" class="lp-skip">Skip to content</a>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="wrap" style="padding-top:28px;padding-bottom:36px;display:flex;flex-wrap:wrap;gap:14px 28px;align-items:baseline;justify-content:space-between">
      <div>
        <div style="font-family:var(--serif);font-size:17px;color:var(--ink)">Gurbani Soul</div>
        <div>Built by Algorythmos · Sri Guru Granth Sahib Ji is shown verbatim from the source edition, cited by Ang.</div>
      </div>
      <nav aria-label="Footer" style="display:flex;gap:18px;flex-wrap:wrap">
        <a href="/search">Knowledge Base</a>
        <a href="/support">Support</a>
        <a href="/privacy">Privacy</a>
      </nav>
    </div>
    <div class="wrap credits" style="padding-bottom:28px">
      Photography of Sri Harmandir Sahib by
      <a href="https://unsplash.com/@aryannikhil">Aryan Nikhil</a> and
      <a href="https://unsplash.com/@travelphotographer">Laurentiu Morariu</a> on Unsplash.
    </div>
  </footer>
</body>
</html>
