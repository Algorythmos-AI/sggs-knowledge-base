---
// Analytics.astro — privacy-scoped Vercel Web Analytics loader. The script is injected ONLY when
// the page is served from gurbanisoul.com (or a subdomain); on serve.py/localhost/staging it is a
// true no-op, so nothing is loaded and no request is made. No @vercel/analytics import — just the
// first-party /_vercel/insights/script.js, which only exists on the Vercel deployment. The
// hostname guard (the gurbanisoul.com regex) sits on the same lines as the insights path so the
// ExternalRequestAllowlist gate can prove the loader is never unconditional.
---
<script is:inline>
  (function () {
    try {
      if (/(^|\.)gurbanisoul\.com$/.test(location.hostname)) {
        var s = document.createElement("script");
        s.defer = true;
        s.src = "/_vercel/insights/script.js";  // guarded by gurbanisoul.com above
        document.head.appendChild(s);
      }
    } catch (e) {}
  })();
</script>
