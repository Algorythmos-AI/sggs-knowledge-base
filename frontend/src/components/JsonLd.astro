---
// JsonLd.astro — emit a JSON-LD structured-data block. `<` is escaped to < so the payload can
// never break out of the <script> element.
export interface Props { data: unknown; }
const { data } = Astro.props;
---
<script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
