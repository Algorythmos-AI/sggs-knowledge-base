---
// DeviceFrame.astro — a CSS-only iPhone frame (ink bezel, Dynamic-Island pill via ::before).
// With `src` it renders a screenshot through astro:assets <Image> (lazy). Without one it shows a
// paper-coloured placeholder screen carrying the alt as its accessible label and a small flat ੴ,
// so alt/count gates pass before the real screenshots land. Colours/shape live in marketing.css.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src?: ImageMetadata;
  alt: string;
  label?: string;
}
const { src, alt, label } = Astro.props;
---
<figure class="device-fig" style="margin:0">
  <div class="device">
    {src
      ? <div class="screen"><Image src={src} alt={alt} loading="lazy" widths={[260, 520]} sizes="260px" /></div>
      : <div class="screen" role="img" aria-label={alt}><span class="ph-onkar gm" aria-hidden="true">ੴ</span></div>}
  </div>
  {label && <figcaption class="muted" style="text-align:center;margin-top:12px;font-size:13.5px">{label}</figcaption>}
</figure>
