      "line_no": 3,
      "raag": null,
      "author": null,
      "is_header": false,
      "gurmukhi": "ਆਦਿ ਸਚੁ ਜੁਗਾਦਿ ਸਚੁ ॥"
    },
    "380": {
      "ang": 8,
      "line_no": 2,
      "raag": null,
      "author": null,
      "is_header": false,
      "gurmukhi": "ਪਵਣੁ ਗੁਰੂ ਪਾਣੀ ਪਿਤਾ ਮਾਤਾ ਧਰਤਿ ਮਹਤੁ ॥"
    },
    "512": {
