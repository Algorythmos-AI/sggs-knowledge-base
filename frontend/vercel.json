{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/analytics/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-insights.onrender.com/api/analytics/:path*"
    },
    {
      "source": "/api/v1/analytics/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-insights.onrender.com/api/v1/analytics/:path*"
    },
    {
      "source": "/api/line_concepts/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-insights.onrender.com/api/line_concepts/:path*"
    },
    {
      "source": "/api/v1/line_concepts/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-insights.onrender.com/api/v1/line_concepts/:path*"
    },
    {
      "source": "/api/neighbors/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-insights.onrender.com/api/neighbors/:path*"
    },
    {
      "source": "/api/v1/neighbors/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-insights.onrender.com/api/v1/neighbors/:path*"
    },
    {
      "source": "/api/related/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-insights.onrender.com/api/related/:path*"
    },
    {
      "source": "/api/v1/related/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-insights.onrender.com/api/v1/related/:path*"
    },
    {
      "source": "/api/themes/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-insights.onrender.com/api/themes/:path*"
    },
    {
      "source": "/api/v1/themes/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-insights.onrender.com/api/v1/themes/:path*"
    },
    {
      "source": "/api/forms/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-knowledge.onrender.com/api/forms/:path*"
    },
    {
      "source": "/api/v1/forms/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-knowledge.onrender.com/api/v1/forms/:path*"
    },
    {
      "source": "/api/timing/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-knowledge.onrender.com/api/timing/:path*"
    },
    {
      "source": "/api/v1/timing/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-knowledge.onrender.com/api/v1/timing/:path*"
    },
    {
      "source": "/api/verify/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-verify.onrender.com/api/verify/:path*"
    },
    {
      "source": "/api/v1/verify/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-staging-verify.onrender.com/api/v1/verify/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "sggs-staging.vercel.app"
        }
      ],
      "destination": "https://sggs-api-staging.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://sggs-knowledge-base.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://buttondown.com; form-action 'self' https://buttondown.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/og/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "integration": false
    }
  }
}
