{
  "_note": "Gurbani Soul brand tokens. Legs: light, dark, lightHC, darkHC (sRGB hex). Source of truth for docs/brand; ios/App/Shared/DesignTokens.swift must match once phase 2 lands. Surfaces mirror DesignTokens.swift (light canvas/card/raised are iOS system grouped backgrounds).",
  "surfaces": {
    "canvas": ["#F2F2F7", "#151210", "#EBEBF0", "#151210"],
    "card":   ["#FFFFFF", "#1E1A17", "#FFFFFF", "#1E1A17"],
    "paper":  ["#FBF7F0", "#171412", "#FFFFFF", "#0E0C0A"]
  },
  "soul": {
    "accentFill": ["#FFBC0D", "#FFBC0D", "#8A6100", "#FFC72C"],
    "accent":     ["#A87900", "#FFBC0D", "#8A6100", "#FFC72C"],
    "accentText": ["#8A6100", "#FFBC0D", "#5C4100", "#FFC72C"],
    "onAccent":   ["#2B1A05", "#2B1A05", "#FFFFFF", "#2B1A05"],
    "accentDeep": ["#FFB81C", "#C08B00", "#FFB81C", "#C08B00"]
  },
  "brand": {
    "red":        ["#DA291C", "#DA291C", "#B01F14", "#DA291C"],
    "onRed":      ["#FFFFFF", "#FFFFFF", "#FFFFFF", "#FFFFFF"],
    "maroon":     ["#8A1538", "#E0658A", "#6E102C", "#EC8FAB"],
    "kraft":      ["#B69A81", "#B69A81", "#B69A81", "#B69A81"]
  },
  "status": {
    "positive": ["#27703F", "#5BC98C", "#1E5731", "#7DD9A6"],
    "negative": ["#B33528", "#FF7A6B", "#8E2A20", "#FF9C8F"],
    "info":     ["#2A63C9", "#7FB0FF", "#2050A5", "#A3C6FF"],
    "special":  ["#6D3FBF", "#B79AF2", "#58309C", "#CDB6F7"]
  },
  "checks": [
    {"fg": "soul.accentText", "on": ["canvas", "card", "paper"], "min": 4.5, "why": "accent as text"},
    {"fg": "soul.accent",     "on": ["card", "paper"],           "min": 3.0, "why": "tint, icons, fill border"},
    {"fg": "soul.onAccent",   "on": ["soul.accentFill"],         "min": 4.5, "why": "label on brand-gold fill"},
    {"fg": "brand.onRed",     "on": ["brand.red"],               "min": 4.5, "why": "label on brand-red fill"},
    {"fg": "brand.maroon",    "on": ["canvas", "card", "paper"], "min": 4.5, "why": "maroon as text"},
    {"fg": "status.positive", "on": ["canvas", "card", "paper"], "min": 4.5, "why": "status text"},
    {"fg": "status.negative", "on": ["canvas", "card", "paper"], "min": 4.5, "why": "status text"},
    {"fg": "status.info",     "on": ["canvas", "card", "paper"], "min": 4.5, "why": "status text"},
    {"fg": "status.special",  "on": ["canvas", "card", "paper"], "min": 4.5, "why": "status text"}
  ],
  "forbidden": [
    {"fg": "soul.accentFill", "on": ["card", "paper"], "max": 3.0, "why": "brand gold is never text or an unbordered fill in light mode"},
    {"fg": "brand.kraft",     "on": ["card", "paper"], "max": 4.5, "why": "kraft is decorative only"},
    {"fg": "brand.red",       "on": ["canvas"],        "max": 4.5, "why": "brand red is fill-only; Ink.negative is the text red"}
  ],
  "spacing": {"xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24},
  "radius": {"button": 4, "chip": 8, "card": 12}
}
