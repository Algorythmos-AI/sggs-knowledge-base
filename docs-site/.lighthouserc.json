{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/onboarding/index.html",
        "http://localhost/onboarding/run-it-locally/index.html",
        "http://localhost/scripture/index.html",
        "http://localhost/scripture/structure/index.html",
        "http://localhost/scripture/gurmukhi-and-unicode/index.html",
        "http://localhost/learning-paths/platform-engineer/index.html",
        "http://localhost/exercises/02-add-a-route/index.html",
        "http://localhost/architecture/overview/index.html",
        "http://localhost/architecture/request-lifecycle/index.html",
        "http://localhost/architecture/search-waterfall/index.html",
        "http://localhost/data/line-record/index.html",
        "http://localhost/data/pipeline/index.html",
        "http://localhost/search/verification-engine/index.html",
        "http://localhost/api/index.html",
        "http://localhost/api/routes/index.html",
        "http://localhost/ios/db-pair-and-launch-integrity/index.html",
        "http://localhost/engineering/invariants/index.html",
        "http://localhost/process/ci-gates/index.html",
        "http://localhost/glossary/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "uses-http2",
          "is-on-https",
          "redirects-http"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
