{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/architecture/overview/index.html",
        "http://localhost/engineering/invariants/index.html",
        "http://localhost/process/runbooks/deploy/index.html",
        "http://localhost/glossary/index.html"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "skipAudits": ["uses-http2", "is-on-https", "redirects-http"] }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
